// ============================================================
//
// ### ProhibitedSymbols ###
//	Mode: Defines mode the system will detect prohibited/allowed symbols, one mode for chat, character names and guild names alike
//		0: Basing on characters defined in Symbols section, disallowed mode, the Regex section is not used
//		1: Basing on Regular Expression definition, Regex section, allowed mode, the Symbols section is not used
//
//	AllowSpace: Defines whether to allow spaces in character and guild names, 0/1, applies to mode 0 only - (not recommented to enable)
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~ Received text is decoded with the code page of the sender's language (LangBase.xml Set) and compared as Unicode characters. Remember to perform a test before going live
//~~ Character names are checked on character creation and on name change. With a code page other than 1252 the client skips its own name check, this file is the only one
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//
// ### ProhibitedSymbols::Symbols::Restrict ###
//	Symbol: defines a symbol to restrict
//	Chat: Restricts Character from entire chat in game, 0/1
//	CharName: Restricts character from character names, 0/1
//	GuildName: Restricts character from Guild Name, 0/1
//
// ### ProhibitedSymbols::Regex::Type ###
//	System: Defines part of the game regular expression applies to
//		0: In-Game Chat
//		1: Character Names
//		2: Guild Names
//	Regex: Regular expression definition of allowed characters
//
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~ For tutorials of how to build own regex refer to http://regexone.com/ or
//~~ https://www3.ntu.edu.sg/home/ehchua/programming/howto/Regexe.html
//~~ or any other guide of your choice. System does not have an effect on
//~~ existing character or guild with prohibited symbol in name, only newly created or renamed
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~ IMPORTANT ~~ File must be saved as UTF-8, symbols and regex are read as UTF-8
//~~ Invalid regex syntax will cause Game Server crash
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//
// STRICTLY NO COMMENTS INSIDE TAGS
-->

<ProhibitedSymbols Mode="0" AllowSpace="0">
	<Symbols> <!-- This section works in DISALLOW mode, Mode 0 only -->
		<Restrict Symbol="%" Chat="1" CharName="1" GuildName="1" />
		<Restrict Symbol="'" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="." Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol=";" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol=":" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="." Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="`" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="@" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="#" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="(" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol=")" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="*" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="^" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="=" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="_" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="-" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="~" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="!" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="?" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="|" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="\" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="/" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="[" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="]" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="=" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol=">" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="<" Chat="0" CharName="1" GuildName="1" />
		<Restrict Symbol="�" Chat="0" CharName="1" GuildName="1" />
	</Symbols>
	<!-- Examples ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	~~ Russian: ^[\w\d\s\Sа-яА-Я]+$
	~~ Viernamese: ^[\w\d\s\SÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơƯĂẠẢẤẦẨẪẬẮẰẲẴẶẸẺẼỀỀỂ µưăạảấầẩẫậắằẳẵặẹẻẽềềểỄỆỈỊỌỎỐỒỔỖỘỚỜỞỠỢỤỦỨỪễệỉịọỏốồổỗộớờởỡợụủứừỬỮỰỲỴÝỶỸửữựỳỵỷỹ]+$
	~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
	<Regex> <!-- Regex works in ALLOW mode, Mode 1 only -->
		<Type System="0" Regex="^[\w\d\s\S]+$" /> <!-- In-Game Chat -->
		<Type System="1" Regex="^[A-Za-z0-9]+$" /> <!-- Character Name -->
		<Type System="2" Regex="^[A-Za-z0-9]+$" /> <!-- Guild Names -->
	</Regex>
</ProhibitedSymbols>